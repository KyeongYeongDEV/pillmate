# cp .env.example .env 후 값 채우기 (.env 는 git 에 올리지 말 것 / 이 example 에는 실제 값 넣지 말 것)

# scrape 대상 (같은 compose 네트워크면 서비스명, 다른 박스면 사설 IP:포트)
APP_TARGET=app:8080
AI_TARGET=ai-server:8001

# Grafana Cloud > 좌측 메뉴 Connections > Prometheus 에서 확인
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=1234567          # 숫자 instance ID
GRAFANA_CLOUD_API_KEY=glc_xxxxxxxxxxxxx  # Access Policy Token (metrics:write 권한)
