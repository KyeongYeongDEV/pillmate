# .env.prod.example — 프로덕션 환경변수 키 목록 (committed placeholder, 값 없음)
# 실제 값이 든 .env.prod 는 CI(deploy.yml)가 GitHub Secrets/Variables 로부터 자동 생성한다.
# 로컬 개발자는 이 파일을 직접 채우지 않는다 — 로컬은 back/.env(gitignored) 사용.
#
# 각 키 뒤 주석 표기:
#   [상수]     = 안전 상수, deploy.yml 워크플로우에 하드코딩 (여기엔 절대 secret/variable 로 안 둠)
#   [Variable] = 비시크릿, GitHub repo Variable (Settings → Actions → Variables)
#   [Secret]   = GitHub repo Secret (Settings → Actions → Secrets)
#
# ⚠ 로컬(back/.env)과 반드시 달라야 하는 값: PILLMATE_DEV_FALLBACK(로컬 true → prod 반드시 false),
#   PILLMATE_JWT_SECRET(로컬 약한 placeholder 재사용 금지 — prod 전용 강한 값 별도 생성),
#   KAKAO_REDIRECT_URI(로컬 http://localhost.. → prod https://도메인/..), POSTGRES_PASSWORD(로컬 dev 값 재사용 금지).
# ⚠ 키명 주의: 로컬 back/.env 는 카카오 REST API 키를 KAKAO_OAUTH_KEY 라는 변수명으로 쓰지만(base compose 의
#   로컬 전용 app 서비스 간접매핑 때문), prod(app-blue/app-green, env_file 직접주입)는 그 매핑이 없어
#   .env.prod 에는 반드시 KAKAO_REST_API_KEY= 로 써야 한다 (KAKAO_OAUTH_KEY 아님 — docker compose config 실측 확인됨).

# ── Spring 프로필 / 인증 안전가드 (상수 — 워크플로우 하드코딩, 여기 값은 문서화 목적) ──
SPRING_PROFILES_ACTIVE=production
# [상수]
PILLMATE_DEV_FALLBACK=false
# [상수]

# ── 도메인 (DuckDNS) / Caddy 자동 HTTPS ─────────────────────────────
# PROD_HOST 하나의 Variable 을 DOMAIN 과 KAKAO_REDIRECT_URI 양쪽에 사용(불일치 방지).
DOMAIN=pillmatefriend.duckdns.org
# [Variable] PROD_HOST
ACME_EMAIL=<real-email-for-lets-encrypt>
# [Variable] ACME_EMAIL

# ── 내부 서비스 연결 (상수) ───────────────────────────────────────────
AI_SERVER_BASE_URL=http://ai-server:8001
# [상수]

# ── DB (Secret) ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=<strong-random-password>
# [Secret]

# ── JWT (Secret — prod 전용 강한 값, 로컬 값 재사용 금지) ─────────────
PILLMATE_JWT_SECRET=<openssl rand -base64 48 로 생성한 강한 값>
# [Secret]

# ── Kakao OAuth ──────────────────────────────────────────────────────
KAKAO_REST_API_KEY=<kakao-rest-api-key>
# [Secret] (GitHub Secret 이름: KAKAO_REST_API_KEY. 로컬 .env 키명 KAKAO_OAUTH_KEY 와 다름 주의)
KAKAO_CLIENT_SECRET=<kakao-client-secret>
# [Secret]
KAKAO_REDIRECT_URI=https://pillmatefriend.duckdns.org/api/v1/auth/kakao/callback
# 워크플로우가 PROD_HOST 로 자동 구성 (https://${PROD_HOST}/api/v1/auth/kakao/callback) — 포트 없음(Caddy 443 프록시)
APP_DEEPLINK=pillmate://oauth/kakao
# [상수]

# ── AWS / S3 ─────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=<aws-access-key-id>
# [Secret]
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
# [Secret]
AWS_REGION=ap-northeast-2
# [Variable] (기본값 ap-northeast-2)
S3_BUCKET_NAME=pillmate-prescriptions
# [Variable]

# ── AI API Keys (로컬과 동일 키 재사용) ───────────────────────────────
GEMINI_API_KEY=<gemini-api-key>
# [Secret]
OPENAI_API_KEY=<openai-api-key>
# [Secret] — ai-server 부팅 필수(없으면 크래시). 대문자 표준(OpenAI_API_KEY 아님).

# ── FCM 푸시 (PILLMATE_NOTIFICATION_PROVIDER=fcm 일 때만 필요) ────────
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
# 워크플로우가 FIREBASE_CREDENTIALS_JSON_B64 Secret 을 decode 해 이 컨테이너 내부 경로에 마운트.
# provider=log 또는 expo 인 동안은 미사용(값 있어도 무해).

# ── 알림 프로바이더 ───────────────────────────────────────────────────
PILLMATE_NOTIFICATION_PROVIDER=log
# [Variable] log(기본, 안전) | expo | fcm. fcm 선택 시 FIREBASE_CREDENTIALS_JSON_B64 Secret 필수.

# ── Sentry / Slack (선택, 빈 값 허용) ─────────────────────────────────
SENTRY_DSN=
# [Secret] optional — app-server 용
SENTRY_DSN_AI=
# [Secret] optional — ai-server 용
SLACK_WEBHOOK_URL=
# [Secret] optional — 운영 알림
