# .env.prod.example — 프로덕션 환경변수 키 목록 (committed placeholder)
# 실제 값은 .env.prod (gitignored) 에 기입. 이 파일은 값 없이 키만 문서화.

# ── 도메인 / Caddy HTTPS ────────────────────────────────────────────
DOMAIN=api.pillmate.duckdns.org
ACME_EMAIL=admin@example.com

# ── Spring Boot 프로필 ───────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=production

# ── DB ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<strong-random-password>

# ── JWT ─────────────────────────────────────────────────────────────
PILLMATE_JWT_SECRET=<strong-32+-chars-random-secret>

# ── Kakao OAuth ──────────────────────────────────────────────────────
KAKAO_REST_API_KEY=<kakao-rest-api-key>
KAKAO_CLIENT_SECRET=<kakao-client-secret>
KAKAO_REDIRECT_URI=https://<your-domain>/api/v1/auth/kakao/callback
APP_DEEPLINK=pillmate://oauth/kakao

# ── AWS / S3 ─────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=pillmate-prescriptions

# ── AI API Keys ──────────────────────────────────────────────────────
GEMINI_API_KEY=<gemini-api-key>
GEMINI_API_KEY1=<gemini-api-key-1>
GEMINI_API_KEY2=<gemini-api-key-2>
OPENAI_API_KEY=<openai-api-key>

# ── Internal Service ─────────────────────────────────────────────────
AI_SERVER_BASE_URL=http://ai-server:8001

# ── Sentry (app-server 용) ───────────────────────────────────────────
SENTRY_DSN=<sentry-dsn-for-spring-app>

# ── Sentry (ai-server 용) ────────────────────────────────────────────
SENTRY_DSN_AI=<sentry-dsn-for-fastapi-ai>

# ── Slack 운영 알림 ───────────────────────────────────────────────────
SLACK_WEBHOOK_URL=<slack-incoming-webhook-url>

# ── 알림 프로바이더 ───────────────────────────────────────────────────
PILLMATE_NOTIFICATION_PROVIDER=expo
