#!/usr/bin/env bash
# Print current state of all inboxes/outboxes.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/common.sh"

count() { ls -1 "$1" 2>/dev/null | wc -l | tr -d ' '; }

cat <<EOF
─── team-orchestra status ($(ts)) ───
dev      inbox=$(count "$MSG_DIR/dev/inbox")    outbox=$(count "$MSG_DIR/dev/outbox")
qa-claude  inbox=$(count "$MSG_DIR/qa-claude/inbox")  outbox=$(count "$MSG_DIR/qa-claude/outbox")
qa-gemini  inbox=$(count "$MSG_DIR/qa-gemini/inbox")  outbox=$(count "$MSG_DIR/qa-gemini/outbox")
reconcile  pending=$(count "$MSG_DIR/reconcile/pending")  done=$(count "$MSG_DIR/reconcile/done")
cto      inbox=$(count "$MSG_DIR/cto/inbox")
EOF
