#!/usr/bin/env bash
# Compact all 6 worker panels with the CLI-specific command.
# Claude panels (BE/FE/QA-Claude/Reviewer/Researcher): /compact
# Gemini panel (QA-Gemini):                            /compress
#
# Usage: ./.cmux/bin/compact-all

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME="$SCRIPT_DIR/../.runtime/cmux.env"
[[ -f "$RUNTIME" ]] || { echo "✗ runtime missing — run ./.cmux/setup-team-be-fe.sh" >&2; exit 1; }
source "$RUNTIME"

send() {
  local target="$1" cmd="$2" label="$3"
  cmux send-panel --panel "$target" --workspace "$CMUX_WORKSPACE" -- "$cmd" >/dev/null 2>&1
  sleep 0.5
  cmux send-key-panel --panel "$target" --workspace "$CMUX_WORKSPACE" Enter >/dev/null 2>&1
  echo "→ $cmd sent to $label ($target)"
}

send "${BE_DEV_SURFACE:-$DEV_SURFACE}" "/compact"  "be-dev"
send "$FE_DEV_SURFACE"                "/compact"  "fe-dev"
send "$QA_CLAUDE_SURFACE"             "/compact"  "qa-claude"
send "$QA_GEMINI_SURFACE"             "/compress" "qa-gemini"
[[ -n "${REVIEWER_SURFACE:-}" ]]   && send "$REVIEWER_SURFACE"   "/compact" "reviewer"
[[ -n "${RESEARCHER_SURFACE:-}" ]] && send "$RESEARCHER_SURFACE" "/compact" "researcher"

echo "✓ all panels compacted (Claude=/compact, Gemini=/compress)"
