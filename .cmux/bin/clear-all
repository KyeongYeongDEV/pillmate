#!/usr/bin/env bash
# Clear all 6 worker panels (CLI-specific command).
# Use when /compact alone doesn't unfreeze panels —
# /clear fully resets session context (system prompt + memory remain).
#
# Claude panels (BE/FE/QA-Claude/Reviewer/Researcher): /clear
# Gemini panel (QA-Gemini):                            /clear
#
# Usage: ./.cmux/bin/clear-all

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME="$SCRIPT_DIR/../.runtime/cmux.env"
[[ -f "$RUNTIME" ]] || { echo "✗ runtime missing — run ./.cmux/setup-team-be-fe.sh" >&2; exit 1; }
source "$RUNTIME"

send() {
  local target="$1" cmd="$2" label="$3"
  cmux send-panel --panel "$target" --workspace "$CMUX_WORKSPACE" -- "$cmd" >/dev/null 2>&1
  sleep 0.5
  cmux send-key-panel --panel "$target" --workspace "$CMUX_WORKSPACE" Enter >/dev/null 2>&1
  echo "→ $cmd sent to $label ($target)"
}

send "${BE_DEV_SURFACE:-$DEV_SURFACE}" "/clear" "be-dev"
send "$FE_DEV_SURFACE"                "/clear" "fe-dev"
send "$QA_CLAUDE_SURFACE"             "/clear" "qa-claude"
send "$QA_GEMINI_SURFACE"             "/clear" "qa-gemini"
[[ -n "${REVIEWER_SURFACE:-}" ]]   && send "$REVIEWER_SURFACE"   "/clear" "reviewer"
[[ -n "${RESEARCHER_SURFACE:-}" ]] && send "$RESEARCHER_SURFACE" "/clear" "researcher"

echo "✓ all panels cleared. system prompt + user memory (MEMORY.md) 자동 재로드."
echo "⚠️  진행 중 task 컨텍스트 손실 — 모든 패널 idle 상태에서만 사용 권장."
