#!/usr/bin/env bash
# watch-api-reset — Gemini Flash RPD 리셋 후 실 8장 재실행 trigger
set -uo pipefail
LOG="/Users/user/Downloads/pillmate/.cmux/.runtime/auto-approve.log"
ts() { date '+%Y-%m-%d %H:%M:%S'; }

# 다음 00:00 UTC 까지 대기 (한국시간 09:00)
NEXT_RESET=$(date -j -f "%Y-%m-%d %H:%M" "$(date +%Y-%m-%d) 09:00" "+%s")
NOW=$(date "+%s")
if [[ $NEXT_RESET -le $NOW ]]; then
  NEXT_RESET=$((NEXT_RESET + 86400))
fi
SLEEP_SEC=$((NEXT_RESET - NOW))
echo "$(ts) ▶ watch-api-reset started — sleeping ${SLEEP_SEC}s until $(date -r $NEXT_RESET '+%Y-%m-%d %H:%M')" >> "$LOG"

sleep "$SLEEP_SEC"

echo "$(ts) 🔄 API 리셋 시간 도달 — BE-Dev 에 실 8장 재실행 trigger" >> "$LOG"

# CTO 패널에 알림 — say 통해 BE-Dev 에 재실행 요청
osascript -e 'display notification "Gemini API 리셋 도달 — 실 약봉투 8장 재실행 가능" with title "PillMate Phase B-4 재실행" sound name "Glass"' 2>/dev/null

# CTO 패널에 say 보내기 (사용자가 처리)
echo "$(ts) 📢 사용자에게 알림 전달 완료 — say be 로 재실행 trigger 필요" >> "$LOG"
