#!/usr/bin/env bash
# restart-panel <be|fe|qa-claude|reviewer|adv|ops> — 패널 컨텍스트 확실한 하드 리셋
# 2026-07-07: 소켓 /clear 가 자동완성에 막혀 실행 안 되는 문제의 유일한 신뢰 대안.
# 방식: Ctrl-C 2회로 claude 종료(→shell) → 동일 런치커맨드로 fresh 재기동(--continue 없음 = 컨텍스트 리셋).
#       role(system prompt)·CLAUDE.md·메모리는 재기동 시 자동 재로드. 워킹트리/outbox/specs 보존.
# ⚠️ busy 패널에 쓰면 진행 중 작업 인터럽트됨 — idle 확인 후 사용.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ORCHESTRA_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PROJECT_ROOT="$(cd "$ORCHESTRA_ROOT/.." && pwd)"
source "$SCRIPT_DIR/../.runtime/cmux.env"

role="${1:-}"; [[ -z "$role" ]] && { echo "Usage: restart-panel <be|fe|qa-claude|reviewer|adv|ops>" >&2; exit 1; }
case "$role" in
  be|be-dev)       sf="$BE_DEV_SURFACE";       prompt="be-dev.md";;
  fe|fe-dev)       sf="$FE_DEV_SURFACE";       prompt="fe-dev.md";;
  qa-claude)       sf="$QA_CLAUDE_SURFACE";    prompt="qa-claude.md";;
  reviewer)        sf="$REVIEWER_SURFACE";     prompt="reviewer.md";;
  adv|adversarial) sf="$ADVERSARIAL_SURFACE";  prompt="adversarial.md";;
  ops)             sf="$OPS_SURFACE";          prompt="ops.md";;
  *) echo "✗ unknown: $role" >&2; exit 1;;
esac

# busy 가드
if cmux capture-pane --panel "$sf" --workspace "$CMUX_WORKSPACE" 2>/dev/null | tail -12 \
     | grep -qE '\([0-9]+m [0-9]+s ·|\([0-9]+s ·|↓ [0-9.]+k tokens'; then
  echo "⚠️  $role busy — 진행 중 작업 있음. idle 확인 후 재시도 (강제하려면 --force)" >&2
  [[ "${2:-}" != "--force" ]] && exit 1
fi

echo "→ $role ($sf) 하드 리셋 (Ctrl-C 2회 → fresh 재기동)"
# 1) claude 종료 → shell
cmux send-key-panel --panel "$sf" --workspace "$CMUX_WORKSPACE" ctrl+c >/dev/null 2>&1; sleep 0.6
cmux send-key-panel --panel "$sf" --workspace "$CMUX_WORKSPACE" ctrl+c >/dev/null 2>&1; sleep 1.5
# 2) fresh 재기동 (setup-team-be-fe.sh 와 동일 커맨드)
launch="cd $PROJECT_ROOT; clear; claude --dangerously-skip-permissions --append-system-prompt-file '$ORCHESTRA_ROOT/prompts/$prompt'"
cmux send-panel --panel "$sf" --workspace "$CMUX_WORKSPACE" -- "$launch\r" >/dev/null 2>&1
sleep 6
# 3) 검증
if cmux capture-pane --panel "$sf" --workspace "$CMUX_WORKSPACE" 2>/dev/null | grep -qiE 'Welcome|bypass permissions|❯|How can I help'; then
  echo "✓ $role 재기동 완료 (컨텍스트 리셋, role 재로드). 워킹트리·specs 보존됨."
  echo "  → 이어서 작업 지시: ./.cmux/bin/say $role \"<spec 참조로 재개>\""
else
  echo "⚠️  재기동 확인 실패 — 패널 수동 확인 필요 (cmux capture-pane --panel $sf)"
fi
