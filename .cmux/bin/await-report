#!/usr/bin/env bash
# Usage: await-report <task_id> [timeout_seconds]
# Blocks until messages/cto/inbox contains a report for the given task_id,
# then prints the report path and content.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/common.sh"

task_id="${1:?task_id required}"
timeout="${2:-1800}"  # default 30 minutes
deadline=$(( $(date +%s) + timeout ))

INBOX="$MSG_DIR/cto/inbox"
mkdir -p "$INBOX"

while :; do
  match="$(ls -1 "$INBOX"/${task_id}-*.json 2>/dev/null | head -n1 || true)"
  if [[ -n "$match" ]]; then
    echo "REPORT: $match"
    payload_file="$(grep -o '"payload_file": *"[^"]*"' "$match" | sed 's/.*"\([^"]*\)"$/\1/')"
    if [[ -n "$payload_file" && -f "$payload_file" ]]; then
      echo "─── consensus report ───"
      cat "$payload_file"
    fi
    archive_message "$match"
    exit 0
  fi
  if (( $(date +%s) >= deadline )); then
    echo "TIMEOUT: no report for $task_id within ${timeout}s" >&2
    exit 2
  fi
  sleep "$POLL_INTERVAL"
done
