#!/usr/bin/env bash
# Phase B-6 재측정 결과 (real_e2e_*after_b6*.md / *.json) watch
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG="$SCRIPT_DIR/../.runtime/auto-approve.log"
DIR="/Users/user/Downloads/pillmate/back/ai_server/reports/eval"

ts() { date '+%Y-%m-%d %H:%M:%S'; }

echo "$(ts) ▶ watch-real-e2e-b6 started (PID $$) — watching $DIR/real_e2e_*after_b6*.md" >> "$LOG"

for i in $(seq 1 60); do
  # *after_b6.md 또는 그 외 새 real_e2e 파일 도착 확인 (6/9 새 파일)
  found=$(find "$DIR" -name "real_e2e_*.md" -newer "$DIR/real_e2e_2026-06-09.md" 2>/dev/null | head -1)
  if [[ -n "$found" ]]; then
    fname=$(basename "$found")
    echo "$(ts) ✅ Phase B-6 재측정 결과 도착: $fname" >> "$LOG"
    osascript -e "display notification \"Phase B-6 실 약봉투 재측정 결과 도착: $fname\" with title \"PillMate #131 완료\" sound name \"Glass\"" 2>/dev/null
    echo "  --- 보고서 핵심 ---" >> "$LOG"
    head -25 "$found" 2>/dev/null | sed 's/^/    /' >> "$LOG"
    echo "  --- 전체: $found ---" >> "$LOG"
    exit 0
  fi
  # CTO inbox DONE 회신도 감지
  inbox_done=$(ls /Users/user/Downloads/pillmate/.cmux/messages/cto/inbox/*REAL-RERUN*.json 2>/dev/null | head -1)
  if [[ -n "$inbox_done" ]]; then
    echo "$(ts) ✅ #131 outbox 회신 도착: $(basename "$inbox_done")" >> "$LOG"
    osascript -e "display notification \"#131 outbox 회신 도착\" with title \"PillMate DONE\" sound name \"Glass\"" 2>/dev/null
    exit 0
  fi
  sleep 60
done

echo "$(ts) ⏰ watch-real-e2e-b6 timeout (60분)" >> "$LOG"
